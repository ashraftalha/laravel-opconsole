{
    "name": "ashraftalha/laravel-opconsole",
    "description": "Monitor. Diagnose. Maintain. An administrative operations console for Laravel applications: health checks, safe Artisan operations, and a log viewer behind explicit authorization.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "admin", "operations", "health-check", "logs", "maintenance"],
    "homepage": "https://github.com/ashraftalha/laravel-opconsole",
    "authors": [
        {
            "name": "Ashraf Talha",
            "email": "ashraf.talha90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ashraftalha/laravel-opconsole/issues",
        "source": "https://github.com/ashraftalha/laravel-opconsole"
    },
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "symfony/process": "^7.2|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "AshrafTalha\\OpConsole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AshrafTalha\\OpConsole\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AshrafTalha\\OpConsole\\OpConsoleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "clear-testbench-cache": "php -r \"array_map('unlink', glob('vendor/orchestra/testbench-core/laravel/bootstrap/cache/*.php') ?: []);\"",
        "test": [
            "@clear-testbench-cache",
            "testbench package:test"
        ],
        "pint": "pint",
        "stan": "phpstan analyse --memory-limit=1G"
    }
}
