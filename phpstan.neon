includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
    level: 5
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            # Larastan cannot infer package namespaced views from this package's own view path.
            message: '#expects view-string\|null#'
            path: src/Http/Controllers/OpConsoleController.php
